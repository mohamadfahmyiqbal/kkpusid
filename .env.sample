# === SERVER CONFIG ===
HTTPS=true
SSL_KEY_FILE=src/localhost/localhost.key
SSL_CRT_FILE=src/localhost/localhost.crt
PORT=5000

# === VAPID (Web Push) - Public key is safe to expose in frontend ===
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
REACT_APP_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE

# === MIDTRANS - Client key is safe to expose in frontend ===
VITE_MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY_HERE
REACT_APP_MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY_HERE

# === APP VERSION ===
VITE_APP_VERSION=1.0.0
REACT_APP_APP_VERSION=1.0.0
